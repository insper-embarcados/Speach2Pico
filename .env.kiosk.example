# Copy to .env at the repository root. Never commit real credentials.
LLM_PROVIDER=openai
LLM_MODEL=gpt-4.1-mini
OPENAI_API_KEY=
STT_PROVIDER=openai
STT_MODEL=whisper-1

# The HC-06 already used in this project: Bluetooth Classic/SPP, not BLE.
BLUETOOTH_ADDRESS=00:23:04:00:33:75
BLUETOOTH_CHANNEL=1
# Optional sounddevice input index (uses the default input when omitted).
# KIOSK_AUDIO_DEVICE=1

# Existing Speach2Pico providers are also supported:
# LLM_PROVIDER=nvidia
# LLM_MODEL=your-enabled-model
# NVIDIA_API_KEY=
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# STT_PROVIDER=nvidia
# STT_FUNCTION_ID=b702f636-f60c-4a3d-a6f4-f3568c13bd7d
# STT_LANGUAGE=pt
# NVIDIA_RIVA_SERVER=grpc.nvcf.nvidia.com:443
# LLM_PROVIDER=anthropic
# LLM_MODEL=your-enabled-model
# ANTHROPIC_API_KEY=
# STT_PROVIDER=google
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/google-service-account.json
